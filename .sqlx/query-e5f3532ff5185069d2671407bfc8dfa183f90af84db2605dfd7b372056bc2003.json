  "query": "SELECT p.id, p.account_id, p.options, p.multiple, p.expires_at,\n                  COALESCE(p.hide_totals, false) AS \"hide_totals!\"\n           FROM polls p\n           JOIN statuses s ON s.id = p.status_id\n           WHERE p.status_id = $1 AND (s.local OR s.uri IS NULL)",
