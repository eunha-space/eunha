  "db_name": "PostgreSQL",
  "query": "SELECT id, domain, severity, reject_media, reject_reports, private_comment,\n                      public_comment, obfuscate, created_at\n               FROM domain_blocks\n               WHERE domain <> '' AND ($1 = domain OR $1 LIKE '%.' || domain)\n               ORDER BY char_length(domain) DESC LIMIT 1",
