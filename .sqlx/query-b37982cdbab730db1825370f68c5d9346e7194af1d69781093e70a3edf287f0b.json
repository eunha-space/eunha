  "query": "SELECT b.id AS sort_id, b.status_id FROM bookmarks b\n               JOIN statuses s ON s.id = b.status_id\n               WHERE b.account_id = $1\n                 AND s.deleted_at IS NULL\n                 AND ($2::bigint IS NULL OR b.id > $2)\n               ORDER BY b.id ASC LIMIT $3",
