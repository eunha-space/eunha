  "query": "SELECT b.user_id, u.account_id AS \"account_id?\", u.email AS \"email?\",\n                  (u.confirmed_at IS NOT NULL AND u.approved AND NOT u.disabled) AS \"active?\"\n           FROM backups b LEFT JOIN users u ON u.id = b.user_id\n           WHERE b.id = $1",
