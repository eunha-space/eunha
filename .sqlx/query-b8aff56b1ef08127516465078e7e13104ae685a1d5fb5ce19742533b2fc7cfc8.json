  "query": "UPDATE accounts\n               SET private_key = COALESCE(NULLIF(private_key, ''), $2),\n                   public_key = CASE WHEN public_key = '' THEN $3 ELSE public_key END,\n                   updated_at = now()\n               WHERE id = $1\n               RETURNING private_key, public_key",
