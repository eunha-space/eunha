{
  "db_name": "PostgreSQL",
  "query": "SELECT a.id AS account_id, a.id_scheme, a.uri AS account_uri, a.username, (a.domain IS NULL) AS \"is_local!\"\n                       FROM follows f JOIN accounts a ON a.id = f.account_id\n                       WHERE f.target_account_id = $1\n                       ORDER BY f.id DESC OFFSET $2 LIMIT $3",
