  "query": "SELECT s.id, s.local, s.uri, s.url, s.reblog_of_id, a.username\n                   FROM media_attachments m\n                   JOIN statuses s ON s.id = m.status_id AND s.deleted_at IS NULL\n                   JOIN accounts a ON a.id = s.account_id\n                   WHERE m.id = $1",
