  "query": "SELECT l.title, a.username, a.domain\n           FROM lists l\n           JOIN list_accounts la ON la.list_id = l.id\n           JOIN accounts a ON a.id = la.account_id\n           WHERE l.account_id = $1\n           ORDER BY l.id, la.id",
