  "query": "SELECT m.status_id, a.id as account_id, a.username, a.domain, a.url\n           FROM accounts a\n           JOIN mentions m ON m.account_id = a.id\n           WHERE m.status_id = ANY($1::bigint[]) AND NOT m.silent\n           ORDER BY m.id ASC",
